RHEO_CORE_INTERNAL_URL=http://localhost:8000

# Host ports for the compose Postgres and core, and for `make demo`'s web
# check (make demo runs the web shell directly with `next start`, outside
# compose). Override any of these only if the default is already bound by
# another project on your machine — nothing on the compose network reads them,
# only the host-side publish moves.
RHEO_PG_PORT=5432
RHEO_CORE_PORT=8000
RHEO_WEB_PORT=3000
RHEO_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres
RHEO_TEST_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres
RHEO_DATA_ROOT=/var/lib/rheo-stream
RHEO_PROFILE=development
