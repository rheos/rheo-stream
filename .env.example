RHEO_CORE_INTERNAL_URL=http://localhost:8000

# Host ports for the compose Postgres and core, and for `make demo`'s web
# check (make demo runs the web shell directly with `next start`, outside
# compose). Override any of these only if the default is already bound by
# another project on your machine — nothing on the compose network reads them,
# only the host-side publish moves.
RHEO_PG_PORT=5432
RHEO_CORE_PORT=8000
RHEO_WEB_PORT=3000
RHEO_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres
RHEO_TEST_CLUSTER_DSN=postgresql://rheo:rheo_dev_only@localhost:5432/postgres

# The in-image default (deploy/README.md § the data-root volume) — right for
# `core`'s container, wrong for a host-side `rheo` command, which needs its own
# path (e.g. an absolute path outside the checkout, or the in-checkout
# .rheo-local/ opt-in) or it will try to create /var/lib/rheo-stream on the host.
RHEO_DATA_ROOT=/var/lib/rheo-stream
RHEO_PROFILE=development

# None of the above is read automatically: `make` sources no .env file, and
# `docker compose` only auto-loads one from deploy/ (next to compose.yaml), not
# from this file's location. Copy this to `.env` and `set -a; . ./.env; set +a`
# (or otherwise export every value) before `make up`/`make demo`/`uv run rheo`.
